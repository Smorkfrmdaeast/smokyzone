rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerPath() {
      return /databases/$(database)/documents/system/admin_status;
    }

    function isOwner() {
      return request.auth != null
        && exists(ownerPath())
        && get(ownerPath()).data.owner_uid == request.auth.uid;
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // Public website content and media metadata; only the registered owner can change it.
    match /site_content/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update, delete: if isOwner() && isValidId(settingId);
    }

    match /media_items/{mediaId} {
      allow read: if isValidId(mediaId);
      allow create, update, delete: if isOwner() && isValidId(mediaId);
    }

    // Private owner record. The first authenticated account claims the single owner slot.
    match /system/admin_status {
      allow read: if request.auth != null && resource.data.owner_uid == request.auth.uid;
      allow create: if request.auth != null
        && !exists(ownerPath())
        && request.resource.data.owner_registered == true
        && request.auth.token.email == 'ifeanyinuels32@gmail.com'
        && request.resource.data.owner_email == 'ifeanyinuels32@gmail.com'
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'owner_registered', 'owner_uid', 'owner_email', 'createdAt', 'createdDevice'
        ]);
      allow update: if isOwner()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.owner_registered == true;
      allow delete: if false;
    }

    // Public setup indicator contains only a boolean. It is created atomically with admin_status.
    match /system/owner_status {
      allow read: if true;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/system/owner_status)
        && request.resource.data.keys().hasOnly(['owner_registered'])
        && request.resource.data.owner_registered == true
        && getAfter(ownerPath()).data.owner_uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Activity records are private to the registered owner.
    match /activity_logs/{logId} {
      allow read, write: if isOwner();
    }

    // Everything else remains denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}