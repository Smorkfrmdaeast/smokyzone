rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerPath() {
      return /databases/$(database)/documents/system/admin_status;
    }

    function isApprovedOwnerEmail(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email in [
          'ifeanyinuels32@gmail.com',
          'nuelsbussiness@gmail.com'
        ]
        && (
          request.auth.token.email == email
          || (
            request.auth.token.keys().hasAny(['firebase'])
            && request.auth.token.firebase.keys().hasAny(['identities'])
            && request.auth.token.firebase.identities.keys().hasAny(['google.com'])
            && request.auth.token.firebase.identities['google.com'] is list
            && request.auth.token.firebase.identities['google.com'].hasAny([email])
          )
        );
    }

    function approvedOwnerEmail() {
      return isApprovedOwnerEmail('ifeanyinuels32@gmail.com')
        || isApprovedOwnerEmail('nuelsbussiness@gmail.com');
    }

    function isOwner() {
      return request.auth != null
        && exists(ownerPath())
        && (
          get(ownerPath()).data.owner_uid == request.auth.uid
          || (
            get(ownerPath()).data.keys().hasAny(['owner_uids'])
            && get(ownerPath()).data.owner_uids.hasAny([request.auth.uid])
          )
        );
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    match /site_content/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update, delete: if isOwner() && isValidId(settingId);
    }

    match /media_items/{mediaId} {
      allow read: if isValidId(mediaId);
      allow create, update, delete: if isOwner() && isValidId(mediaId);
    }

    // First approved account bootstraps the owner record. A second approved
    // account may add only its own UID/email; the primary owner UID is immutable.
    match /system/admin_status {
      allow read: if isOwner() || approvedOwnerEmail();
      allow create: if approvedOwnerEmail()
        && !exists(ownerPath())
        && request.resource.data.owner_registered == true
        && isApprovedOwnerEmail(request.resource.data.owner_email)
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uids == [request.auth.uid]
        && request.resource.data.owner_emails == [request.resource.data.owner_email]
        && request.resource.data.keys().hasOnly([
          'owner_registered', 'owner_uid', 'owner_email',
          'owner_uids', 'owner_emails', 'createdAt', 'createdDevice'
        ]);
      allow update: if (
          isOwner()
          && request.resource.data.owner_uid == resource.data.owner_uid
          && request.resource.data.owner_registered == true
        ) || (
          approvedOwnerEmail()
          && resource.data.owner_registered == true
          && request.resource.data.owner_registered == true
          && request.resource.data.owner_uid == resource.data.owner_uid
          && request.resource.data.owner_uids is list
          && request.resource.data.owner_emails is list
          && (!resource.data.keys().hasAny(['owner_uids'])
            || request.resource.data.owner_uids.hasAll(resource.data.owner_uids))
          && (!resource.data.keys().hasAny(['owner_emails'])
            || request.resource.data.owner_emails.hasAll(resource.data.owner_emails))
          && request.resource.data.owner_uids.hasAny([request.auth.uid])
          && (
            (request.resource.data.owner_emails.hasAny(['ifeanyinuels32@gmail.com']) && isApprovedOwnerEmail('ifeanyinuels32@gmail.com'))
            || (request.resource.data.owner_emails.hasAny(['nuelsbussiness@gmail.com']) && isApprovedOwnerEmail('nuelsbussiness@gmail.com'))
          )
          && request.resource.data.owner_uids.size() <= 2
          && request.resource.data.owner_emails.size() <= 2
        );
      allow delete: if false;
    }

    match /system/owner_status {
      allow read: if true;
      allow create: if approvedOwnerEmail()
        && !exists(/databases/$(database)/documents/system/owner_status)
        && request.resource.data.keys().hasOnly(['owner_registered'])
        && request.resource.data.owner_registered == true
        && getAfter(ownerPath()).data.owner_uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /activity_logs/{logId} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
