rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/system/admin_status).data.owner_uid == request.auth.uid;
    }

    match /audio/{audioFile} {
      // Published audio can be streamed by website visitors.
      allow read: if true;

      // Only the registered owner can upload, replace, or delete audio.
      allow write: if isOwner()
        && (
          request.resource == null
          || (
            request.resource.size <= 50 * 1024 * 1024
            && request.resource.contentType.matches('audio/.*')
          )
        );
    }
  }
}