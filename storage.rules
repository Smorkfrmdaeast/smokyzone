rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage Rules cross-service lookups only support the default Firestore
    // database. Smoky Zone uses a named database, so authorize the two
    // verified Google owner identities directly from the Firebase Auth token.
    function isApprovedOwnerEmail(email) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email in [
          'ifeanyinuels32@gmail.com',
          'nuelsbussiness@gmail.com'
        ]
        && (
          request.auth.token.email == email
          || (
            request.auth.token.keys().hasAny(['firebase'])
            && request.auth.token.firebase.keys().hasAny(['identities'])
            && request.auth.token.firebase.identities.keys().hasAny(['google.com'])
            && request.auth.token.firebase.identities['google.com'] is list
            && request.auth.token.firebase.identities['google.com'].hasAny([email])
          )
        );
    }

    function isOwner() {
      return isApprovedOwnerEmail('ifeanyinuels32@gmail.com')
        || isApprovedOwnerEmail('nuelsbussiness@gmail.com');
    }

    // Public visitors can view published media. Only the two verified
    // owner Google accounts can upload, replace, or delete files.
    match /audio/{fileName} {
      allow read: if true;
      allow write: if isOwner()
        && (
          request.resource == null
          || (
            request.resource.size <= 50 * 1024 * 1024
            && request.resource.contentType.matches('audio/.*')
          )
        );
    }

    match /media/images/{fileName} {
      allow read: if true;
      allow write: if isOwner()
        && (
          request.resource == null
          || (
            request.resource.size <= 15 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')
          )
        );
    }

    match /media/videos/{fileName} {
      allow read: if true;
      allow write: if isOwner()
        && (
          request.resource == null
          || (
            request.resource.size <= 100 * 1024 * 1024
            && request.resource.contentType.matches('video/.*')
          )
        );
    }
  }
}
